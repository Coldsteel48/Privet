# facial-auth configuration — copy to /etc/facial-auth/config.conf
#
# device_path / pixel_format are left commented out below: confirm the
# real values first via `v4l2-ctl --list-devices` and
# `v4l2-ctl --list-formats-ext -d /dev/videoN` against your IR device
# node(s). Until these are set, facial-auth-verify/-enroll will fail to
# open the camera and cleanly report "unavailable" — safe by default, not
# a silent misconfiguration.
#
# Prefer a /dev/v4l/by-id/... path over a raw /dev/videoN: the plain
# device numbers are assigned in enumeration order and are not guaranteed
# stable across reboots/replugs on cameras that expose multiple video
# nodes (metadata nodes, IR+RGB pairs, etc). List yours with
# `ls -la /dev/v4l/by-id/`.
#
# Example confirmed against a Logitech "Logi 4K Stream Edition" webcam:
# its IR node only ever exposes GREY at a fixed 340x340 @30fps (no other
# resolution/framerate is offered — frame_width/frame_height below MUST
# match exactly, V4L2_S_FMT will just clamp to the nearest supported mode
# otherwise). No separate IR-illuminator control was found in
# `v4l2-ctl --all -d /dev/videoN` — instead, the IR LEDs strobe on
# alternating captured frames (confirmed: consecutive frames alternate
# between near-black/ambient and a clearly IR-lit face, mean pixel value
# ~0.65 vs ~50). This is a liveness/anti-spoofing pattern, not a bug —
# facial-auth-verify's existing per-attempt retry loop already handles it
# correctly (a dark frame just yields 0 detected faces and the loop moves
# to the next attempt), see max_capture_attempts below.
#
# device_path = /dev/v4l/by-id/usb-046d_Logi_4K_Stream_Edition_371DE0C2-video-index2
# pixel_format = grey

# IR is strongly recommended (real depth/liveness signal, like Windows
# Hello). Setting camera_mode = rgb opts into a plain webcam, which is far
# more spoofable (no depth channel, vulnerable to a printed photo or a
# video replay) — facial-auth-enroll requires an explicit interactive
# confirmation or --i-understand-the-risk before it will accept this.
camera_mode = ir
require_ir = true

# How long (seconds) pam_facial.so waits for an answer (box click or
# typed y/n) to its confirmation prompt before treating silence as a
# decline and falling through to your password prompt without opening the
# camera. Also settable from facial-auth-control's Settings page. Unlike
# most other keys in this file, this one is read by pam_facial.so itself
# (not facial-auth-verify) — see readConfirmationTimeoutMs() in
# src/core/pam/PamConfirmationPrompt.hpp — since the prompt happens before
# facial-auth-verify is even started. Missing key, a non-positive value,
# or anything unparsable all fall back to the 20s default; values are
# clamped to [1, 300] seconds.
confirmation_timeout_sec = 20

# How the same prompt is actually presented when a display IS reachable
# (in practice: sudo run from an already-logged-in graphical session with
# DISPLAY/WAYLAND_DISPLAY preserved) — also settable from
# facial-auth-control's Settings page. See ConfirmationMode in
# src/core/pam/PamConfirmationPrompt.hpp. Has no effect at the console
# login prompt or a graphical greeter (no display reachable there at
# all) — see greeter_confirmation_mode below for that context instead.
#   gui  - try a real clickable Yes/No box first (facial-auth-confirm);
#          if the helper itself fails to launch, falls back to the
#          plain-text prompt (still only in this display-reachable
#          context). Default.
#   text - always use the plain-text prompt, never attempt the box.
#   none - never ask at all; go straight to face recognition.
confirmation_mode = gui

# How the prompt is presented at the console `login` prompt or a
# graphical greeter's login screen (including COSMIC via greetd) — i.e.
# whenever no display is reachable at all, since those run before any
# desktop session exists and a mouse-driven box has nothing to draw into.
# Fully independent of confirmation_mode above: this setting governs the
# login screen regardless of what confirmation_mode is set to, and
# confirmation_mode governs everywhere a display is reachable regardless
# of what this is set to — neither one is a fallback for the other.
#   text - fall back to the plain-text prompt. Default.
#   none - skip confirmation and go straight to face recognition.
greeter_confirmation_mode = text

# Must match your IR node's actual (and often only) supported resolution
# exactly — see the Logi 4K Stream Edition example above (340x340).
frame_width = 340
frame_height = 340
capture_timeout_ms = 2000
# On a strobing IR camera (see the note above), roughly half of all
# frames are dark/undetectable before face detection even runs, and
# empirically only ~25% of attempts yield a successful detection even
# during good conditions (facial-auth-enroll needs ~32 attempts for 8
# successful samples). 20 attempts gives a 0.75^20 ≈ 0.3% chance of total
# failure, vs 0.75^3 = 42% at a budget of 3 — the latter is why "Test
# Recognition" could fail almost every time even with a correctly-tuned
# illumination_gain. Each capture attempt returns near-instantly under
# normal streaming, so this costs well under a second in the normal
# case; a stalled camera is independently bounded by the outer PAM
# timeout (pam_facial.cpp's kOuterTimeoutMs).
max_capture_attempts = 20

detector_model_path = /etc/facial-auth/models/face_detection_yunet.onnx
embedder_model_path = /etc/facial-auth/models/face_recognition_sface.onnx

# cosine | euclidean
distance_metric = cosine
# Starting point only — tune against your own hardware/lighting once IR
# capture is working; see docs/testing-safely.md.
match_threshold = 0.36

# Software brightness multiplier applied to every captured frame (1.0 =
# no change) — NOT real IR-illuminator control; no such control was found
# on the confirmed hardware (see the strobing note above). Tune this live
# against the preview on facial-auth-control's Enrollment tab, then press
# "Save Illumination" there — that's the only sanctioned way to set this,
# so real enroll/verify captures use the same value you tuned by eye.
illumination_gain = 1.0

# How long (seconds) facial-auth-enroll records raw frames while you turn
# your head during Enroll/Re-enroll, before post-processing the buffer
# into several angle-tagged templates (left/right/up/down/center) that
# verify then matches against all of. Longer gives more usable frames to
# populate the full 3x3 angle grid; too few usable frames (e.g. barely
# moving your head, or a very short duration) just falls back to fewer
# buckets — see runEnroll's bucketing logic. Not needed if you don't plan
# to re-enroll after upgrading; existing enrollments keep working as a
# single template until re-enrolled.
enroll_video_duration_sec = 8
